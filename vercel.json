{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend/savranpay-web && npm ci",
  "buildCommand": "cd frontend/savranpay-web && npm run build",
  "outputDirectory": "frontend/savranpay-web/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/router"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
