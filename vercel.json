{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend/savranpay-web && npm ci",
  "buildCommand": "cd frontend/savranpay-web && npm run build",
  "outputDirectory": "frontend/savranpay-web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://savranpay.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://savranpay.onrender.com/health/:path*"
    },
    {
      "source": "/metrics",
      "destination": "https://savranpay.onrender.com/metrics"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
